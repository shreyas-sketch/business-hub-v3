# Business AI Action Hub — environment variables
# Copy to .env for local work, or paste into Railway → Variables for production.
# Anything left blank falls back to the default shown in backend/app/config.py.

# ── Core (required in production) ──────────────────────────────────────────────
APP_ENV=production                      # production | development (development only works with a localhost APP_URL)
APP_URL=https://hub.yourdomain.in       # the public https address, no trailing slash — used in badge, invite and website links
                                        # (blank on Railway = the domain Railway generated for the service)
MONGO_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=action_hub
JWT_SECRET=                             # 32+ random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PHONES=+919999900000              # comma-separated, with +91. These numbers see Admin → Pulse

# ── Test deployment only (leave blank once real owners use the hub) ─────────────
DEMO_PASSWORD=                          # email logins for the demo accounts (admin@demo.hub, legacy@demo.hub, …), 8+ characters
SEED_DEMO=                              # true = load the demo hub on start, ONLY if the database is empty (never overwrites data)
DEMO_PHONES=                            # numbers whose login code is shown on screen instead of sent, e.g. the demo logins:
                                        # 9999900000,9820000001,9820000002,9820000003,9820000004,9820000005,9820000006,9820000011,9820000012
                                        # anyone who knows one of these numbers can log in as it

# ── Program identity (footer and public pages) ─────────────────────────────────
PROGRAM_NAME=OwnerDesk
SPEAKER_LINE=Akshat Dani · Chirag J.

# ── AI engine ──────────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic                   # anthropic | gemini | openai | mock (mock = canned demo text, no key needed)
AI_MODEL=                               # blank = claude-haiku-5-5 / gemini-2.5-flash / gpt-4.1-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=                         # voice notes (SOP from a voice note, meeting notes) need an OpenAI or a Gemini key,
                                        # whichever AI_PROVIDER you use; OpenAI is tried first. Voice is also used for onboarding,
                                        # the English polisher, quotations and the Sales Training Gym
AI_EFFORT=low                           # Claude thinking depth for the hub's short JSON tasks; blank for models without effort
AI_CONCURRENCY=32                       # AI calls in flight at once per server process; the rest wait their turn
AI_RETRIES=2                            # a 429 / 503 / 529 ("slow down", "overloaded") from the engine is tried again this many times
ANTHROPIC_API_KEYS=                     # more Claude keys, comma-separated, used in turn. Only adds capacity when each key is on its
                                        # own Anthropic account (rate limits are per account); keys of one account share its limit
GEMINI_API_KEYS=                        # the same for Gemini / OpenAI
OPENAI_API_KEYS=
AI_FALLBACK=                            # backup engines when the main one is busy (429/529) or down, e.g. gemini,openai or
                                        # gemini:gemini-2.5-pro — each needs its key above. Blank = the main engine only
AI_COST_INR_PER_M_INPUT=85              # only used for the cost estimate on Pulse
AI_COST_INR_PER_M_OUTPUT=425

# ── WhatsApp tool — the HUB's own number. It only ever messages owners, never their customers ─────────────
# v2.3: pick the WhatsApp tool the hub's number runs on. aisensy (default, what the hub has always used) | wati | interakt | meta
# Wati, Interakt and Meta-direct are built from their public API documents and are untested until a real account is
# connected: send yourself a login code and an owner alert before switching a live hub.
# The template names below keep their AISENSY_* names whichever tool you use; in Wati / Interakt / Meta they're that
# tool's template names, with the variables numbered {{1}}, {{2}}… in the order shown.
WHATSAPP_PROVIDER=aisensy
# The OwnerDesk v2.3 setup applies itself on the hub's first start. false only for the demo seed and pre-v2.3 browser checks.
# V23_AUTO_APPLY=true
WHATSAPP_TEMPLATE_LANGUAGE=en           # Interakt and Meta: the templates' language code
WATI_API_URL=                           # Wati → API Docs: your API endpoint, e.g. https://live-mt-server.wati.io/123456
WATI_API_TOKEN=                         # Wati → API Docs: the access token
INTERAKT_API_KEY=                       # Interakt → Settings → Developer settings: the secret key (sent as "Basic <key>")
WHATSAPP_HUB_PHONE_NUMBER_ID=           # meta only: the hub number's phone number id
WHATSAPP_HUB_ACCESS_TOKEN=              # meta only: a permanent system-user token
AISENSY_API_KEY=
AISENSY_OTP_CAMPAIGN=                   # API campaign on an AUTHENTICATION template: {{1}} = code
AISENSY_OTP_BUTTON=true                 # true when the template has a copy-code button (Meta requires one for authentication)
AISENSY_LEAD_ALERT_CAMPAIGN=            # UTILITY, to the owner: {{1}} business, {{2}} customer name, {{3}} customer phone, {{4}} message
AISENSY_DIGEST_CAMPAIGN=                # UTILITY, morning digest to the owner: {{1}} business, {{2}} summary
AISENSY_OWNER_ALERT_CAMPAIGN=           # UTILITY, any other alert to the owner: {{1}} business, {{2}} the message
# Day-1 report (₹99 webinar) — see docs/DAY1_REPORT.md for the template to submit to Meta
AISENSY_REPORT_CAMPAIGN=                # media template to the attendee: image (or PDF) header, {{1}} first name, {{2}} one line; URL button → APP_URL/r/{{1}}
AISENSY_REPORT_MEDIA=image              # image | pdf — what the header carries
AISENSY_REPORT_LINK=button              # button: the URL button's {{1}} is the report's token · text: the link goes in as {{3}}
DAY1_STATUS_WEBHOOK_SECRET=             # set it, then point AiSensy's message-status webhook at APP_URL/api/hooks/day1-status/<secret>
DAY1_DAILY_CAP=5000                     # public reports a day (India time), all webinars together
DAY1_RUNS_PER_IP_PER_10MIN=30           # per network address
DAY1_WORKERS=8                          # reports built at the same time in each server process
DAY1_SITE_SECONDS=20                    # longest the website check may take on a report
                                        # (your week is ready, a chat needs you, the Monday CEO report)
# Customer messages never use these. Below ₹1.5L the owner taps "Send on WhatsApp" (their own phone); from Growth Mentorship
# they go from the owner's OWN AiSensy number, set up per owner in Admin → the owner → Connections (see the guide).

# ── SMS fallback for login codes (MSG91, needs DLT registration) ───────────────
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Payments (Razorpay) ────────────────────────────────────────────────────────
# With these set, owners pay inside the hub: Membership is a monthly autopay subscription, the programs are one payment.
# Without them: test payments on a laptop (no real money), and "Talk to us" on a real deployment.
RAZORPAY_KEY_ID=                        # rzp_live_… (Dashboard → Account & Settings → API keys)
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID_LITE=                  # plan_… — the ₹1,999 monthly plan you create under Subscriptions → Plans
RAZORPAY_WEBHOOK_SECRET=                # the secret you type when adding the webhook https://<APP_URL>/api/razorpay/webhook
COMMISSION_HOLD_DAYS=7                  # a referral commission can be approved only after this refund window
REFERRAL_COMMISSION_MONTHS=12           # commission is paid on a referred owner's payments for this many months
ACCESS_DAYS_PROGRAM=365                 # how long each one-time program lasts after payment
ACCESS_DAYS_RUNNING=365
ACCESS_DAYS_GROWTH=180
ACCESS_DAYS_OFFICE=365

# Fallback upgrade links, used only while the Razorpay keys above are blank (e.g. existing Razorpay payment pages)
UPGRADE_URL_LITE=                       # ₹1,999/month Membership
UPGRADE_URL_PROGRAM=                    # ₹10,000 Action Program
UPGRADE_URL_RUNNING=                    # ₹25,000 Running the Business
UPGRADE_URL_GROWTH=                     # ₹1,50,000 Growth Mentorship
UPGRADE_URL_OFFICE=                     # ₹6,00,000 LegacyWorkforce
                                        # blank = the button opens "Talk to us" and the request shows on Pulse

# ── Automations ──────────────────────────────────────────────────────────────────
RUN_SCHEDULER=true                      # runs the automations' schedule inside the web process (safe with several workers)
FOLLOWUP_DAYS=1,3,7                     # follow-up automation: days after an inquiry
REVIEW_REQUEST_DELAY_DAYS=2             # review requests: days after a lead is marked Won
PAYMENT_REMINDER_GAP_DAYS=3             # payment reminders: days between reminders (4 at most)

# ── Member websites ────────────────────────────────────────────────────────────
SITES_DOMAIN=employz.ai                 # every website at <name>.employz.ai — needs ONE wildcard DNS record (*.employz.ai) on Railway.
                                        # Blank: websites live at APP_URL/s/<name>
RESERVED_SUBDOMAINS=                    # blank = the built-in list (app, www, api, admin, mail, …). Names no owner may take
PEXELS_API_KEY=                         # free key from pexels.com/api — stock photos on owners' websites. Blank = their own photos or designed artwork
CUSTOM_DOMAIN_TARGET=                   # own domains (Growth Mentorship and up): leave blank on Railway — you add each owner's domain
                                        # in Railway and paste the records Railway shows into Admin → Own domains

# ── Owners' own accounts (Growth Mentorship and up) ────────────────────────────
CONNECTIONS_KEY=                        # encrypts every owner's API keys at rest. Generate once and never change:
                                        #   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                                        # blank = derived from JWT_SECRET (then changing JWT_SECRET makes stored keys unreadable)
AISENSY_PROJECT_API_BASE=https://apis.aisensy.com/project-apis/v1   # two-way chat replies (AiSensy project API)
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0                # owners on Meta's Cloud API directly
EMPLOYZ_API_BASE=https://services.leadconnectorhq.com               # Employz.ai (GoHighLevel API v2)
EMPLOYZ_APP_URL=                        # e.g. https://app.employz.ai — the "Open Employz.ai" button when an owner has no own link
ELEVENLABS_API_BASE=https://api.elevenlabs.io
CAMPAIGN_DAILY_CAP=200                  # money-campaign messages per owner per day (10am–7pm)
AI_REPLIES_PER_CHAT_PER_DAY=20          # AI replies per WhatsApp chat per day, before it waits for a person
CALLS_PER_OWNER_PER_DAY=60              # AI Telecaller calls per owner per day

# ── Referral rewards ───────────────────────────────────────────────────────────
REFERRAL_FRIEND_TRIAL_DAYS=30           # friend who joins through a badge or invite link
REFERRAL_FIRST_FRIEND_REWARD_DAYS=30    # referrer, when their first friend's website goes live
REFERRAL_BONUS_RUNS_PER_LIVE_FRIEND=10  # referrer, for every later friend who goes live
REFERRAL_COMMISSION_PERCENT=30          # commission on a referred owner's payments; you approve and pay it in Admin

# ── Limits ─────────────────────────────────────────────────────────────────────
OTP_COUNTRY_CODES=91                    # login codes are only sent to these country codes
OTP_PER_IP_PER_HOUR=1500                # a whole workshop room shares one Wi-Fi address
INQUIRIES_PER_SITE_PER_HOUR=120         # ceiling per member website
TRUSTED_PROXY_HOPS=1                    # Railway = 1. Put Cloudflare in front → 2
WELCOME_FULL_HUB=true                   # new signups get the whole hub; switch it off later in Admin → Onboarding

# ── v2.1: email to customers (decision D4: Amazon SES in Mumbai) ──────────────
EMAIL_PROVIDER=mock                     # ses | mock. mock only works on a laptop or in tests; a real deployment with mock sends nothing and says so
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=                      # an IAM user allowed ses:SendEmail, ses:SendRawEmail and ses:GetEmailIdentity, and
                                        # s3:GetObject on the inbound bucket only (see docs/DEPLOY_CHECKLIST.md)
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM_DOMAIN=mail.employz.ai       # needs SPF, DKIM and DMARC records (Admin → Email shows what's missing)
SES_CONFIGURATION_SET=                  # sends delivered / bounced / complained events to SNS
EMAIL_EVENTS_SECRET=                    # long random string. SNS subscription: APP_URL/api/hooks/email-events/<this>
EMAIL_EVENTS_TOPIC_ARN=                 # the SNS topic ARN for those events; anything from another topic is refused
INBOUND_EMAIL_DOMAIN=                   # e.g. in.employz.ai (MX → SES inbound; receipt rule → S3 action that notifies the SNS topic).
                                        # Empty = no inquiry addresses, no reply detection
EMAIL_INBOUND_SECRET=                   # SNS subscription for inbound mail: APP_URL/api/hooks/email-in/<this>
EMAIL_INBOUND_TOPIC_ARN=                # required on a live hub: the SNS topic ARN for inbound mail; anything from another topic is refused
EMAIL_INBOUND_BUCKET=                   # the S3 bucket SES's S3 action writes each email to. With it, emails of any size (attachments
                                        # too) arrive; the SNS action alone bounces anything over 150 KB. Only this bucket is ever read
EMAIL_INBOUND_BUCKET_REGION=            # blank = AWS_REGION
EMAIL_INBOUND_MAX_MB=30                 # larger emails are skipped
EMAILS_PER_OWNER_PER_DAY=300
PROPOSALS_PER_OWNER_PER_DAY=100         # automatic proposal emails per owner per day

# ── v2.1: files, compliance, cash flow, dashboard ─────────────────────────────
UPLOAD_MAX_MB=10                        # compliance documents, logos (and lead magnet PDFs in P1); stored in MongoDB (`files`)
COMPLIANCE_REMINDER_DAYS=30,7,1,0       # days before each due date the owner is reminded
CASHFLOW_ALERT_DAYS=10                  # the morning cash-flow watch alerts the owner when a shortfall is this many days away or less
DASHBOARD_CACHE_SECONDS=60              # each workspace's dashboard numbers are reused for this long (new leads, payments and posts clear it at once)

# ── Live event link (Admin → Live event; docs/EVENT.md) ───────────────────────
EVENT_WORKERS=24                        # packs in phase 1 (website + rules) at once, per server process
EVENT_AI_WORKERS=40                     # packs in phase 2 (AI) at once, per server process
EVENT_AI_CONCURRENCY=24                 # AI calls for packs at once, per process — below AI_CONCURRENCY so people in their hub get a turn
EVENT_RUNS_PER_IP_PER_10MIN=600         # packs from one network address (a hall shares one)
EVENT_SITE_SECONDS=20                   # longest the website read may take
EVENT_AI_SECONDS=150                    # longest one AI step may take, waiting in line included

# ── v2.2: Reviews & reputation, Competitor Watch (Google Places API (New)) ────
GOOGLE_PLACES_API_KEY=                  # server-side key, restricted to "Places API (New)" and the server's IPs; billing must be on.
                                        # Blank = Google reviews and competitors' Google ratings are off (pasting reviews still works).
                                        # Google content (review words, stars, ratings) is kept at most 30 days; the hub clears it hourly.
                                        # Leave blank until you've decided: Google's terms expressly allow caching only place IDs (and
                                        # lat/lng for 30 days) — see docs/V22_HANDOFF.md, "Google reviews".
GOOGLE_PLACES_API_BASE=https://places.googleapis.com/v1

# ── v2.3: Tender finder (GeM) ────
GEM_RELAY_URL=                          # GeM answers only from India. When the hub runs outside India (Railway US West), the Function
                                        # URL of the GeM relay in AWS Mumbai (relay/gem-lambda; setup in docs/DEPLOY_CHECKLIST.md 9.5).
                                        # Blank = the hub asks bidplus.gem.gov.in directly.
GEM_RELAY_KEY=                          # the RELAY_KEY set on the relay function (openssl rand -hex 32)
